{
  "manifest_version": 3,
  "name": "WebWrite",
  "version": "1.9.1",
  "description": "Draw and write on any website — smooth pen, brush, shapes, highlighter, and eraser.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "WebWrite — draw on this page",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/katex.min.css",
        "lib/fonts/*",
        "lib/tesseract.min.js",
        "lib/worker.min.js",
        "lib/tesseract-core.wasm.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/katex.min.js",
        "lib/jspdf.umd.min.js",
        "content/stroke-engine.js",
        "content/background-layer.js",
        "content/theme.js",
        "content/text-tool.js",
        "content/ink-ocr.js",
        "content/recorder.js",
        "content/export.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-drawing": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle drawing mode"
    }
  }
}
